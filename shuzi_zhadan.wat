		i32.store8
	)

	(func $update		
		i32.const 450957 ;; scene 
		i32.load8_u
		i32.const 0
		i32.eq
		if
			call $update_scene_title
		else
			i32.const 450957 ;; scene
			i32.load8_u
			i32.const 1
			i32.eq
			if
				call $update_scene_game
			end
		end
		call $tick
	)

	(func $update_scene_game (local $i i32) (local $j i32)
		;; for back_button
		i32.const 128 ;; dx
		i32.const 0   ;; dy
		i32.const 64  ;; dw
		i32.const 32  ;; dh
		call $squ_col
		;; check to see is_active
		i32.const 450948
		i32.load8_u
		i32.const 1
		i32.eq
		i32.and
		if
			i32.const 450957 ;; change scene to title
			i32.const 0
			i32.store8
			;; reset game
			i32.const 4172337 ;; min_num
			i32.const 0
			i32.store8
			i32.const 4172338 ;; max_num
			i32.const 99
			i32.store8
			i32.const 4172339 ;; game_over
			i32.const 0
			i32.store8
		end

		i32.const 4172337 ;; min_num
		i32.load8_u
		i32.const 4172338 ;; max_num
		i32.load8_u
		i32.ne
		if
			i32.const 4172339 ;; game_over
			i32.load8_u
			i32.const 1
			i32.ne
			if
				;; for squares
				i32.const 0
				local.set $i
				loop $loop_i
					i32.const 0
					local.set $j
					loop $loop_j

						local.get $i ;; add $i and $j to check if gt min_num
						i32.const 10
						i32.mul
						local.get $j
						i32.add
						i32.const 4172337 ;; min_num
						i32.load8_u
						i32.ge_u

						local.get $i ;; add $i and $j to check if lt max_num
						i32.const 10
						i32.mul
						local.get $j
						i32.add
						i32.const 4172338 ;; max_num
						i32.load8_u
						i32.le_u
						i32.and

						if
			
							;; check_if_mouse_over_square
							i32.const 4    ;; dx
							i32.const 32   ;;
							local.get $j   ;;
							i32.mul
							i32.add
							i32.const 36  ;; dy
							i32.const 32 ;;
							local.get $i
							i32.mul
							i32.add
							i32.const 24  ;; dw
							i32.const 24  ;; dh
							call $squ_col
							;; check to see is_active
							i32.const 450948
							i32.load8_u
							i32.const 1
							i32.eq
							i32.and
							if
								;; check to see if unlucky number
								i32.const 4172336 ;; unlucky_num
								i32.load8_u
								local.get $i ;; add $i and $j to check if equal to unlucky_num
								i32.const 10
								i32.mul
								local.get $j
								i32.add
								i32.eq
								if
									i32.const 4172339 ;; game_over
									i32.const 1
									i32.store8
								else
									;; check to see if selected number is less than unlucky number
									local.get $i
									i32.const 10
									i32.mul
									local.get $j
									i32.add
									i32.const 4172336 ;; unlucky_num
									i32.load8_u
									i32.lt_u
									if
										;; update min_num
										i32.const 4172337 ;; min_num
										local.get $i
										i32.const 10
										i32.mul
										local.get $j
										i32.add
										i32.const 1
										i32.add
										i32.store8
									end
									;; check to see if selected number is greater than unlucky number
									local.get $i
									i32.const 10
									i32.mul
									local.get $j
									i32.add
									i32.const 4172336 ;; unlucky_num
									i32.load8_u
									i32.gt_u
									if
										;; update max_num
										i32.const 4172338 ;; max_num
										local.get $i
										i32.const 10
										i32.mul
										local.get $j
										i32.add
										i32.const 1
										i32.sub
										i32.store8
									end
								end
							end
						end
						;; incerment $j
						local.get $j
						i32.const 1
						i32.add
						local.tee $j
						i32.const 10
						i32.lt_u
						br_if $loop_j
					end
					;; increment $i
					local.get $i
					i32.const 1
					i32.add
					local.tee $i
					i32.const 10
					i32.lt_u
					br_if $loop_i
				end
			end
		end
	)

	(func $update_scene_title
		;; check to see if click or tap
		i32.const 450948 ;; is_active
		i32.load8_u
		i32.const 1
		i32.eq
		if
			;; saver
			;; attempt to reset is_active
			i32.const 450948
			i32.const 0
			i32.store8

			;; set unlucky number
			i32.const 4172336 ;; unlucky_num
			i32.const 450960 ;; pseudo_num_seed
			i32.const 100
			i32.const 450952 ;; load value from timer_8
	    	i32.load8_u
			i32.mul
			i32.add
			i32.const 450954 ;; timer_100
		    i32.load8_u
			i32.add
			i32.load8_u
			i32.store8
			i32.const 450957 ;; change scene to game 
			i32.const 1
			i32.store8
		end

		;; timer_8
		i32.const 450952
	    i32.load8_u
		i32.const 7
		i32.lt_u
		if
			i32.const 450952
			i32.const 450952
		    i32.load8_u
			i32.const 1
			i32.add
			i32.store8
		else
			i32.const 450952
			i32.const 0
			i32.store8
		end
	)

