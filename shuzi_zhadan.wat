(module
	(memory (export "memory") 640) ;; (512 +  128 pages) * 65,536 bytes

	;; color an area with a specific color
	(func $color_area
		(param $clr_ndx i32) (param $dx i32) (param $dy      i32) (param $dw    i32) (param $dh i32)
		(local $i       i32) (local $j  i32) (local $des_mem i32) (local $color i32)

		;; get the color index from the map
		local.get $clr_ndx ;;
		i32.const   4      ;;
		i32.mul            ;; must multiply
		local.set   $color ;;

		loop $loop_i
				;; check to see if pixel is out of view on the y axis
				;; if (y >= 0 && y < 352)
				local.get $dy
				local.get $i  ;; this is incrementing with dy
				i32.add
				i32.const 0
				i32.ge_s
				local.get $dy
				local.get $i  ;; this is incrementing with dy
				i32.add
				i32.const 352 ;; screen height
				i32.lt_s
				i32.and
			if
			    i32.const 0x00000000
			    local.set $j
			    loop $loop_j
					;; check to see if pixel is out of view on the x axis
					;; if (x >= 0 && x < 320)
					local.get $dx
					local.get $j  ;;
					i32.add
					i32.const 0   ;; screen_x
					i32.ge_s
					local.get $dx
					local.get $j  ;; this is incrementing with dw
					i32.add
					i32.const 320 ;; screen_width
					i32.lt_s
					i32.and
					;;
					if  ;; render pixel
					    ;; des_mem_addr setup
						local.get   $i         ;;
						local.get   $dy        ;;
						i32.add                ;;
						i32.const   320        ;; screen_width * ($i + $dy)
						i32.const   0x00000004 ;;
						i32.mul                ;;
						i32.mul                ;; solved the problem for dy?

						local.get   $j         ;;
						local.get   $dx        ;;
						i32.add                ;;
						i32.const   0x00000004 ;;
						i32.mul                ;;
						i32.add                ;; solved the problem for dx?

						local.set   $des_mem   ;;

						;; apply RGB values						 
						local.get   $des_mem ;;
						local.get   $color   ;;
						i32.const   450560   ;; color index map
						i32.add              ;;
						i32.load             ;; index color
						i32.store            ;; src_mem_addr output
					end
					local.get   $j         ;; increment $j by 1
					i32.const   0x00000001 ;;
					i32.add                ;;
					local.tee   $j         ;; check to see if(j < 320)
					local.get   $dw        ;; change to dw
					i32.lt_u               ;;
					br_if       $loop_j    ;;
				end
			end
			local.get   $i         ;; increment $i by 1
			i32.const   0x00000001 ;;
			i32.add                ;;
			local.tee   $i         ;; check to see if(i < 352)
			local.get   $dh        ;; maybe dh 
			i32.lt_u               ;;
			br_if       $loop_i    ;;
		end
	)

	;; render an image 
	(func $render_widget
		(param $img i32) (param $dx i32) (param $dy      i32) (param $dw      i32) (param $dh i32)
		(local $i   i32) (local $j  i32) (local $des_mem i32) (local $clr_ndx i32)

		loop $loop_i
				;; check to see if pixel is out of view on the y axis
				;; if (y >= 0 && y < 4096)
				local.get $dy
				local.get $i  ;; this is incrementing with dy
				i32.add
				i32.const 0
				i32.ge_s
				local.get $dy
				local.get $i  ;; this is incrementing with dy
				i32.add
				i32.const 352 ;; screen height
				i32.lt_s
				i32.and
			if
			    i32.const 0x00000000
			    local.set $j
			    loop $loop_j
					;; check to see if pixel is out of view on the x axis
					;; if (x >= 0 && x < 4096)
					local.get $dx
					local.get $j  ;; this is incrementing with dw
					i32.add
					i32.const 0   ;; screen x
					i32.ge_s

					local.get $dx
					local.get $j  ;; this is incrementing with dw
					i32.add
					i32.const 320 ;; screen width 
					i32.lt_s

					i32.and

				    ;; check to see if it's a transparent pixel
				    local.get   $img         ;;
					local.get   $i           ;;
					local.get   $dw          ;;
					i32.mul                  ;;
					local.get   $j           ;;
					i32.add                  ;;
					i32.add                  ;;
					i32.load8_u              ;; byte from image data
					local.tee   $clr_ndx     ;;
					i32.const   0x00         ;;
					i32.ne                   ;;

					i32.and

					if  ;; render pixel
						local.get $clr_ndx     ;;
						i32.const   4          ;;
						i32.mul                ;; must multiply
						local.set   $clr_ndx   ;;

					    ;; des_mem_addr setup
						local.get   $i         ;;
						local.get   $dy        ;;
						i32.add                ;;
						i32.const   320        ;; screen_width * ($i + $dy)
						i32.const   0x00000004 ;;
						i32.mul                ;;
						i32.mul                ;; solved the problem for dy?

						local.get   $j         ;;
						local.get   $dx        ;;
						i32.add                ;;
						i32.const   0x00000004 ;;
						i32.mul                ;;
						i32.add                ;; solved the problem for dx?

						local.set   $des_mem   ;;
						
						;; apply RGBA values
						local.get   $des_mem   ;;
						local.get   $clr_ndx   ;;
						i32.const   450560     ;; color index map
						i32.add                ;;
						i32.load               ;; R index color
						i32.store              ;; src_mem_addr output

						;; extra effect
						local.get $clr_ndx
						i32.const 4
						i32.eq
						if
							local.get   $des_mem   ;;
							i32.const 1
							i32.add
							i32.const 450958 ;; timer_32
	    					i32.load8_u
							i32.const 4 ;; make the animation work faster
							i32.mul
							i32.store8
						end

					end
					local.get   $j         ;; increment $j by 1
					i32.const   0x00000001 ;;
					i32.add                ;;
					local.tee   $j         ;; check to see if(j < dw)
					local.get   $dw        ;; change to dw
					i32.lt_u               ;;
					br_if       $loop_j    ;;
				end
			end
			local.get   $i         ;; increment $i by 1
			i32.const   0x00000001 ;;
			i32.add                ;;
			local.tee   $i         ;; check to see if(i < dh)
			local.get   $dh        ;; maybe dh 
			i32.lt_u               ;;
			br_if       $loop_i    ;;
		end
	)

	;; render an image in full color
	(func $render_fullcolor
		(param $img i32) (param $dx i32) (param $dy i32) (param $dw i32) (param $dh i32)
		(local $i i32) (local $j i32) (local $des_mem i32) (local $src_mem i32)
		(local $img_stride i32) (local $src_color i32) (local $dest_color i32)
		(local $alpha i32) (local $inv_alpha i32)
		(local $r i32) (local $g i32) (local $b i32) (local $dest_r i32) (local $dest_g i32) (local $dest_b i32)
	
		;; Pre-calculate image row stride
		local.get $dw
		i32.const 4
		i32.mul
		local.set $img_stride
	
		;; Start from y=0
		i32.const 0
		local.set $i
	
		loop $loop_i
			;; Calculate screen y position
			local.get $dy
			local.get $i
			i32.add
			local.tee $j
		
			;; Check Y bounds
			i32.const 0
			i32.ge_s
			local.get $j
			i32.const 352
			i32.lt_s
			i32.and
			if
				;; Calculate source row base
				local.get $img
				local.get $i
				local.get $img_stride
				i32.mul
				i32.add
				local.set $src_mem
			
				;; Calculate destination row base
				local.get $j
				i32.const 320
				i32.mul
				i32.const 4
				i32.mul
				local.set $des_mem
			
				;; Start from x=0
				i32.const 0
				local.set $j
			
				loop $loop_j
					;; Calculate screen x position
					local.get $dx
					local.get $j
					i32.add
					local.set $des_mem  ;; store x position temporarily
				
					;; Check X bounds
					local.get $des_mem
					i32.const 0
					i32.ge_s
					local.get $des_mem
					i32.const 320
					i32.lt_s
					i32.and
					if
						;; Load source pixel (RGBA format - alpha in highest byte)
						local.get $src_mem
						local.get $j
						i32.const 4
						i32.mul
						i32.add
						i32.load
						local.set $src_color
					
						;; Extract alpha channel (bits 24-31)
						local.get $src_color
						i32.const 24
						i32.shr_u
						i32.const 255
						i32.and
						local.set $alpha
					
						;; Only blend if not fully transparent
						local.get $alpha
						i32.const 0
						i32.ne
						if
							;; Calculate destination address
							local.get $dy
							local.get $i
							i32.add
							i32.const 320
							i32.mul
							local.get $dx
							local.get $j
							i32.add
							i32.add
							i32.const 4
							i32.mul
							local.set $des_mem
						
							;; Load destination color
							local.get $des_mem
							i32.load
							local.set $dest_color
						
							;; Calculate inverse alpha
							local.get $alpha
							i32.const 255
							i32.xor
							local.set $inv_alpha
						
							;; Extract source RGBA components
							;; R (bits 16-23)
							local.get $src_color
							i32.const 16
							i32.shr_u
							i32.const 255
							i32.and
							local.set $r
						
							;; G (bits 8-15)
							local.get $src_color
							i32.const 8
							i32.shr_u
							i32.const 255
							i32.and
							local.set $g
						
							;; B (bits 0-7)
							local.get $src_color
							i32.const 255
							i32.and
							local.set $b
						
							;; Extract destination RGBA components
							;; R
							local.get $dest_color
							i32.const 16
							i32.shr_u
							i32.const 255
							i32.and
							local.set $dest_r
						
							;; G
							local.get $dest_color
							i32.const 8
							i32.shr_u
							i32.const 255
							i32.and
							local.set $dest_g
						
							;; B
							local.get $dest_color
							i32.const 255
							i32.and
							local.set $dest_b
						
							;; Blend: result = (src * alpha + dest * (255 - alpha)) / 255
							;; Red component
							local.get $r
							local.get $alpha
							i32.mul
							local.get $dest_r
							local.get $inv_alpha
							i32.mul
							i32.add
							i32.const 255
							i32.div_u
							local.set $r
						
							;; Green component
							local.get $g
							local.get $alpha
							i32.mul
							local.get $dest_g
							local.get $inv_alpha
							i32.mul
							i32.add
							i32.const 255
							i32.div_u
							local.set $g
						
							;; Blue component
							local.get $b
							local.get $alpha
							i32.mul
							local.get $dest_b
							local.get $inv_alpha
							i32.mul
							i32.add
							i32.const 255
							i32.div_u
							local.set $b
						
							;; Combine into final color with full opacity (alpha = 255)
							;; Format: 0xFFRRGGBB
							local.get $r
							i32.const 16
							i32.shl
							local.get $g
							i32.const 8
							i32.shl
							i32.or
							local.get $b
							i32.or
							i32.const 255
							i32.const 24
							i32.shl
							i32.or
							local.set $src_color
						
							;; Store the blended color
							local.get $des_mem
							local.get $src_color
							i32.store
						end
					end
				
					local.get $j
					i32.const 1
					i32.add
					local.tee $j
					local.get $dw
					i32.lt_u
					br_if $loop_j
				end
			end
		
			local.get $i
			i32.const 1
			i32.add
			local.tee $i
			local.get $dh
			i32.lt_u
			br_if $loop_i
		end
	)

	(func (export "render")
		;; init system
	    i32.const 450559 
		i32.load8_u
		i32.const 0xFF
		i32.ne
		if
			i32.const 0      ;; base_addr
			i32.const 0xFF   ;; value to fill
			i32.const 450559 ;; end memory.fill
			memory.fill
		end
		i32.const 450957 
		i32.load8_u
		i32.const 0
		i32.eq
		if
			call $scene_title
		end
		i32.const 450957
		i32.load8_u
		i32.const 1
		i32.eq
		if
			call $scene_game
		end
		call $update
	)

	(func $scene_game (local $i i32) (local $j i32)
		;; empty_space
		i32.const 62  ;; clr_ndx
		i32.const 0   ;; dx
		i32.const 0   ;; dy
		i32.const 320 ;; dw
		i32.const 32  ;; dh
		call $color_area

		i32.const 4172339 ;; game_over
		i32.load8_u
		i32.const 1
		i32.eq
		if (result i32)
			i32.const 4154544 ;; game_over_zh
		else
			i32.const 4146352 ;; game_view_title_zh
		end
		i32.const 0   ;; dx
		i32.const 0   ;; dy
		i32.const 80  ;; dw
		i32.const 32  ;; dh
		call $render_widget
		;; empty_space
		i32.const 62  ;; clr_ndx
		i32.const 128 ;; dx
		i32.const 0   ;; dy
		i32.const 64  ;; dw
		i32.const 32  ;; dh
		call $color_area

		i32.const 4172339 ;; game_over
		i32.load8_u
		i32.const 1
		i32.eq
		if (result i32)
			i32.const 4158640 ;; game_over_en
		else
			i32.const 4150448 ;; game_view_title_en 
		end
		i32.const 192 ;; dx
		i32.const 0   ;; dy
		i32.const 128 ;; dw
		i32.const 32  ;; dh
		call $render_widget
		;; main_bg
		i32.const 2   ;; clr_ndx
		i32.const 0    ;; dx
		i32.const 32   ;; dy
		i32.const 320  ;; dw
		i32.const 320  ;; dh
		call $color_area

		;; render numbers
		i32.const 0
		local.set $i
		loop $loop_i
			i32.const 0
			local.set $j
			loop $loop_j

				local.get $i ;; add $i and $j to check if gt min_num
				i32.const 10
				i32.mul
				local.get $j
				i32.add
				i32.const 4172337 ;; min_num
				i32.load8_u
				i32.ge_u

				local.get $i ;; add $i and $j to check if lt max_num
				i32.const 10
				i32.mul
				local.get $j
				i32.add
				i32.const 4172338 ;; max_num
				i32.load8_u
				i32.le_u
				i32.and

				if
					i32.const 4172336 ;; unlucky_num
					i32.load8_u
					local.get $i ;; add $i and $j to check if equal to unlucky_num
					i32.const 10
					i32.mul
					local.get $j
					i32.add
					i32.eq
					i32.const 4172339 ;; game_over
					i32.load8_u
					i32.const 1
					i32.eq
					i32.and

					if
						;; shuzi_zhadan
						i32.const 4162736
						i32.const 1024 ;; for frames
						i32.const 450958 ;; timer_32
						i32.load8_u
						i32.const 7
						i32.gt_u
						if (result i32)
							i32.const 1
						else
							i32.const 0
						end
						i32.const 450958 ;; timer_32
						i32.load8_u
						i32.const 15
						i32.gt_u
						if (result i32)
							i32.const 1
						else
							i32.const 0
						end
						i32.const 450958 ;; timer_32
						i32.load8_u
						i32.const 23
						i32.gt_u
						if (result i32)
							i32.const 1
						else
							i32.const 0
						end
						i32.add
						i32.add
						i32.mul
						i32.add
						i32.const 32   ;; dx
						local.get $j   ;;
						i32.mul
						i32.const 32  ;; dy
						i32.const 32  ;;
						local.get $i
						i32.mul
						i32.add
						i32.const 32  ;; dw
						i32.const 32  ;; dh
						call $render_widget
						;; increment $j
						local.get $j
						i32.const 1
						i32.add
						local.set $j
						br $loop_j 
					end

					;; check_if_mouse_over_square
					i32.const 4    ;; dx
					i32.const 32   ;;
					local.get $j   ;;
					i32.mul
					i32.add
					i32.const 36  ;; dy
					i32.const 32 ;;
					local.get $i
					i32.mul
					i32.add
					i32.const 24  ;; dw
					i32.const 24  ;; dh
					call $squ_col
					if (result i32)
						i32.const 6   ;; clr_ndx
					else
						;; black_square
						i32.const 62   ;; clr_ndx
					end
					i32.const 4    ;; dx
					i32.const 32   ;;
					local.get $j   ;;
					i32.mul
					i32.add
					i32.const 36  ;; dy
					i32.const 32 ;;
					local.get $i
					i32.mul
					i32.add
					i32.const 24  ;; dw
					i32.const 24  ;; dh
					call $color_area

					;; for iterations 0 - 8
					local.get $i
					i32.const 10
					i32.mul
					local.get $j
					i32.add
					i32.const 9
					i32.lt_u
					if
						i32.const 4166832 ;; numbers 288 bytes each
						i32.const 288
						local.get $i
						i32.const 10
						i32.mul
						local.get $j
						i32.const 1
						i32.add
						i32.add
						i32.mul
						i32.add

						i32.const 10    ;; dx
						i32.const 32   ;;
						local.get $j   ;;
						i32.mul
						i32.add
						i32.const 36  ;; dy
						i32.const 32 ;;
						local.get $i
						i32.mul
						i32.add
						i32.const 12  ;; dw
						i32.const 24  ;; dh
						call $render_widget

						;; increment $j
						local.get $j
						i32.const 1
						i32.add
						local.set $j
						br $loop_j
					end

					;; saver
					;; for iterations 9 - 98
					local.get $i
					i32.const 10
					i32.mul
					local.get $j
					i32.add
					i32.const 99
					i32.lt_u
					if
						;; digit_00
						i32.const 4166832 ;; numbers 288 bytes each
						i32.const 288
						local.get $i
						i32.const 10
						i32.mul
						local.get $j
						i32.const 1
						i32.add
						i32.add
						i32.const 10
						i32.div_u
						i32.const 10
						i32.rem_u
						i32.mul
						i32.add
						i32.const 4    ;; dx
						i32.const 32   ;;
						local.get $j   ;;
						i32.mul
						i32.add
						i32.const 36  ;; dy
						i32.const 32 ;;
						local.get $i
						i32.mul
						i32.add
						i32.const 12  ;; dw
						i32.const 24  ;; dh
						call $render_widget
						;; digit_01
						i32.const 4166832 ;; numbers 288 bytes each
						i32.const 288
						local.get $i
						i32.const 10
						i32.mul
						local.get $j
						i32.const 1
						i32.add
						i32.add
						i32.const 10
						i32.rem_u
						i32.mul
						i32.add
						i32.const 16   ;; dx
						i32.const 32   ;;
						local.get $j   ;;
						i32.mul
						i32.add
						i32.const 36  ;; dy
						i32.const 32 ;;
						local.get $i
						i32.mul
						i32.add
						i32.const 12  ;; dw
						i32.const 24  ;; dh
						call $render_widget
					end

					;; render if iteration is 99
					local.get $i
					i32.const 10
					i32.mul
					local.get $j
					i32.add
					i32.const 99
					i32.eq
					if
						;; shuzi_100 (render this if 100)
						i32.const 4169712
						i32.const 292 ;; dx
						i32.const 324 ;; dy
						i32.const 24  ;; dw
						i32.const 24  ;; dh
						call $render_widget
					end
				end
				;; increment $j
				local.get $j
				i32.const 1
				i32.add
				local.tee $j
				i32.const 10
				i32.lt_u
				br_if $loop_j
			end
			;; increment $i
			local.get $i
			i32.const 1
			i32.add
			local.tee $i
			i32.const 10
			i32.lt_u
			br_if $loop_i
		end

		;; back_btn
		i32.const 4170288
		i32.const 128 ;; dx
		i32.const 0   ;; dy
		i32.const 64  ;; dw
		i32.const 32  ;; dh
		call $render_widget

		i32.const 4172337 ;; min_num
		i32.load8_u
		i32.const 4172338 ;; max_num
		i32.load8_u
		i32.eq
		if
			;; render_trophy 
			i32.const 4172344
			i32.const 102400 ;; bytes_per_frame
			i32.const 450959 ;; timer_120
		    i32.load8_u
			i32.const 5
			i32.div_u
			i32.mul
			i32.add		
			i32.const 80  ;; dx
			i32.const 112  ;; dy
			i32.const 160 ;; dw
			i32.const 160 ;; dh
			call $render_fullcolor
			;; render_win_msg
			i32.const 6629944
			i32.const 4   ;; dx
			i32.const 36  ;; dy
			i32.const 128 ;; dw
			i32.const 64  ;; dh
			call $render_widget
		end
	)

	(func $scene_title
		i32.const 62  ;; clr_ndx
		i32.const 0   ;; dx
		i32.const 0   ;; dy
		i32.const 320 ;; dw
		i32.const 352 ;; dh
		call $color_area
		;; tap_to_play_zh
		i32.const 4138160
		i32.const 0   ;; dx
		i32.const 0   ;; dy
		i32.const 80  ;; dw
		i32.const 32  ;; dh
		call $render_widget
		;; render_title
		i32.const 451760
		i32.const 0   ;; dx
		i32.const 32  ;; dy
		i32.const 320 ;; dw
		i32.const 320 ;; dh
		call $render_widget
	)

	(func $squ_col 
		(param $obj_dx i32) (param $obj_dy i32)
		(param $obj_dw i32) (param $obj_dh i32)
		(result i32)
	    ;; pointer_dx > $obj_dx
		i32.const    450944  ;; pointer_dx_mem_addr
	    i32.load16_u         ;; pointer_dx
		local.get $obj_dx    ;; obj_dx00
		i32.gt_u
		;; pointer_dx < $obj_dx + $obj_dw 
		i32.const    450944  ;; pointer_dx_mem_addr
	    i32.load16_u         ;; pointer_dx
		local.get $obj_dx    ;; $obj_dx
		local.get $obj_dw    ;; $obj_dw
		i32.add              ;; obj_dx01
		i32.lt_u
		i32.and
	    ;; pointer_dy > $obj_dy
		i32.const    450946  ;; pointer_dy_mem_addr
	    i32.load16_u         ;; pointer_dy
		local.get $obj_dy    ;; obj_dy00
		i32.gt_u
		i32.and
		;; pointer_dy < $obj_dy + $obj_dh
		i32.const    450946  ;; pointer_dy_mem_addr
	    i32.load16_u         ;; pointer_dy
		local.get $obj_dy    ;; $obj_dy 
		local.get $obj_dh    ;; $obj_dh
		i32.add              ;; $obj_dy01
		i32.lt_u
		i32.and
	)

	(func $tick
		;; timer_32 (irregular timer)
		i32.const 450958
	    i32.load8_u
		i32.const 31
		i32.lt_u
		if
			i32.const 450958
			i32.const 450958
		    i32.load8_u
			i32.const 1
			i32.add
			i32.store8
		else
			i32.const 450958
			i32.const 0
			i32.store8
		end

		;; timer_60
		i32.const 450953
	    i32.load8_u
		i32.const 59
		i32.lt_u
		if
			i32.const 450953
			i32.const 450953
		    i32.load8_u
			i32.const 1
			i32.add
			i32.store8
		else
			i32.const 450953
			i32.const 0
			i32.store8
		end
		;; timer_100
		i32.const 450954
	    i32.load8_u
		i32.const 99
		i32.lt_u
		if
			i32.const 450954
			i32.const 450954
		    i32.load8_u
			i32.const 1
			i32.add
			i32.store8
		else
			i32.const 450954
			i32.const 0
			i32.store8
		end
		;; timer_120
		i32.const 450959
	    i32.load8_u
		i32.const 115
		i32.lt_u
		if
			i32.const 450959
			i32.const 450959
		    i32.load8_u
			i32.const 1
			i32.add
			i32.store8
		else
			i32.const 450959
			i32.const 0
			i32.store8
		end
		;; timer_180
		i32.const 450955
	    i32.load8_u
		i32.const 175
		i32.lt_u
		if
			i32.const 450955
			i32.const 450955
		    i32.load8_u
			i32.const 1
			i32.add
			i32.store8
		else
			i32.const 450955
			i32.const 0
			i32.store8
		end
		;; timer_256
		i32.const 450956
		i32.const 450956
	    i32.load8_u
		i32.const 1
